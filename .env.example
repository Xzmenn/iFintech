# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://ifintech:ifintech@localhost:5432/ifintech?schema=public"

# NextAuth session configuration. Generate a unique secret for each deployment.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL for links in emails and PWA assets.
APP_URL="http://localhost:3000"

# Server timezone for finance periods and scheduled jobs.
TZ="Asia/Jakarta"

# Local disk storage directory for uploads.
STORAGE_DIR="./storage"

# SMTP configuration (when blank, reset links are logged in development).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="iFintech <noreply@ifintech.app>"

# Protects the scheduled recurring-transaction endpoint.
CRON_SECRET="replace-with-a-long-random-secret"

# Logger threshold: debug, info, warn, or error.
LOG_LEVEL="info"
